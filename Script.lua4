-- برمجة التوسيع
local isExpanded = false
CounterBadge.MouseButton1Click:Connect(function()
    isExpanded = not isExpanded
    if isExpanded then
        ToggleBtn.Visible = false
        MainFrame:TweenSizeAndPosition(
            UDim2.new(0, 340, 0, 55),
            UDim2.new(0.5, -170, MainFrame.Position.Y.Scale, MainFrame.Position.Y.Offset),
            Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true
        )
    else
        ToggleBtn.Visible = true
        MainFrame:TweenSizeAndPosition(
            UDim2.new(0, 240, 0, 130),
            UDim2.new(0.5, -120, MainFrame.Position.Y.Scale, MainFrame.Position.Y.Offset),
            Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true
        )
    end
end)

-- السحب والتحريك
local dragging, dragStart, startPos
MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
MainFrame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

local toggled = true
startAuto()
ToggleBtn.MouseButton1Click:Connect(function()
    toggled = not toggled
    ToggleBtn.Text = toggled and "AUTO: ON" or "AUTO: OFF"
    ToggleBtn.BackgroundColor3 = toggled and Color3.fromRGB(0, 170, 50) or Color3.fromRGB(170, 0, 0)
    if toggled then startAuto() else stopAuto() end
end)
