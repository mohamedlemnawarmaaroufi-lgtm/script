local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

local isTracking = false
local KEEP_DISTANCE = 3.5
local activeConnection = nil

local function hasTool(plr)
    if not plr then return false end
    local c = plr.Character
    if c then
        for _, v in ipairs(c:GetChildren()) do
            if v:IsA("Tool") then return true end
        end
    end
    local bp = plr:FindFirstChild("Backpack")
    if bp then
        for _, v in ipairs(bp:GetChildren()) do
            if v:IsA("Tool") then return true end
        end
    end
    return false
end

local function getClosest()
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return nil, 999 end
    local mp = LocalPlayer.Character.HumanoidRootPart.Position
    local cp, cd = nil, 999
    local playersList = Players:GetPlayers()
    for _, p in ipairs(playersList) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local d = (p.Character.HumanoidRootPart.Position - mp).Magnitude
            if d < cd then cd = d; cp = p end
        end
    end
    return cp, cd
end

local function startAuto()
    if activeConnection then activeConnection:Disconnect() end
    isTracking = true
    
    activeConnection = RunService.Heartbeat:Connect(function()
        if not isTracking then return end
        pcall(function()
            local char = LocalPlayer.Character
            if not char or not char:FindFirstChild("Humanoid") then return end
            if not hasTool(LocalPlayer) then char.Humanoid.WalkSpeed = 16 return end
            
            local t, d = getClosest()
            if not t or not t.Character or not t.Character:FindFirstChild("HumanoidRootPart") then return end
            
            char.Humanoid.WalkSpeed = 21
            if d <= KEEP_DISTANCE then
                local dir = (char.HumanoidRootPart.Position - t.Character.HumanoidRootPart.Position).Unit
                char.Humanoid:MoveTo(t.Character.HumanoidRootPart.Position + dir * KEEP_DISTANCE)
            else
                char.Humanoid:MoveTo(t.Character.HumanoidRootPart.Position)
            end
        end)
    end)
end

local function stopAuto()
    isTracking = false
    if activeConnection then activeConnection:Disconnect() activeConnection = nil end
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.WalkSpeed = 16
    end
end

if CoreGui:FindFirstChild("HMAutoGui") then CoreGui:FindFirstChild("HMAutoGui"):Destroy() end

