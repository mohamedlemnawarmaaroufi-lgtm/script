	check.BackgroundColor3 = Theme.Accent
	check.Size = UDim2.new(0, 14, 0, 14)
	check.Position = UDim2.new(0.5, -7, 0.5, -7)
	check.Visible = false
	check.Parent = box
	Corner(check, 4)
	table.insert(AccentBackgrounds, check)
	
	local enabled = false
	local function SetState(val)
		enabled = val
		check.Visible = enabled
		Tween(box, {BackgroundColor3 = enabled and Theme.Card2 or Theme.Sidebar}, 0.12):Play()
		callback(enabled)
	end
	
	card.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			SetState(not enabled)
		end
	end)
	return card, SetState
end

local function MakeSlider(parent, title, min, max, default, callback)
	local card = MakeCard(parent, 70)
	local label = MakeText(card, title, 13, Theme.Text)
	label.Position = UDim2.new(0, 14, 0, 10)
	label.Size = UDim2.new(1, -80, 0, 20)
	
	local valLabel = MakeText(card, tostring(default), 13, Theme.Accent, true)
	valLabel.Position = UDim2.new(1, -74, 0, 10)
	valLabel.Size = UDim2.new(0, 60, 0, 20)
	valLabel.TextXAlignment = Enum.TextXAlignment.Right
	valLabel.Font = Enum.Font.Code
	
	local track = Instance.new("Frame")
	track.BackgroundColor3 = Theme.Sidebar
	track.BorderSizePixel = 0
	track.Size = UDim2.new(1, -28, 0, 6)
	track.Position = UDim2.new(0, 14, 0, 46)
	track.Parent = card
	Corner(track, 3)
	
	local fill = Instance.new("Frame")
	fill.BackgroundColor3 = Theme.Accent
	fill.BorderSizePixel = 0
	fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
	fill.Parent = track
	Corner(fill, 3)
	table.insert(AccentBackgrounds, fill)
	
	local sliding = false
	local function UpdateInput(input)
		local pos = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		local val = math.floor(min + ((max - min) * pos))
		fill.Size = UDim2.new(pos, 0, 1, 0)
		valLabel.Text = tostring(val)
		callback(val)
	end
	
	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			sliding = true 
			UpdateInput(input)
		end
	end)
	UIS.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then sliding = false end
	end)
	UIS.InputChanged:Connect(function(input)
		if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then UpdateInput(input) end
	end)
	return card
end

local function MakeStepper(parent, title, minValue, maxValue, initialValue, stepSize, callback)
	local card = MakeCard(parent, 76)
	local titleLabel = MakeText(card, title, 13, Theme.Text)
	titleLabel.Position = UDim2.new(0, 14, 0, 12)
	titleLabel.Size = UDim2.new(1, -120, 0, 20)
	
	local valueLabel = MakeText(card, tostring(initialValue), 13, Theme.Accent, true)
	valueLabel.Position = UDim2.new(0, 14, 0, 42)
	valueLabel.Size = UDim2.new(1, -120, 0, 20)
	valueLabel.Font = Enum.Font.Code
	
	local minusBtn = MakeButton(card, "-")
	minusBtn.Position = UDim2.new(1, -94, 0.5, -17)
	minusBtn.Size = UDim2.new(0, 34, 0, 34)
	
	local plusBtn = MakeButton(card, "+")
	plusBtn.Position = UDim2.new(1, -48, 0.5, -17)
	plusBtn.Size = UDim2.new(0, 34, 0, 34)
	
	local currentValue = initialValue
	local function UpdateVal(newVal)
		currentValue = math.clamp(newVal, minValue, maxValue)
		valueLabel.Text = tostring(currentValue)
		callback(currentValue)
	end
	
	minusBtn.Activated:Connect(function() UpdateVal(currentValue - stepSize) end)
	plusBtn.Activated:Connect(function() UpdateVal(currentValue + stepSize) end)
	return card
end

