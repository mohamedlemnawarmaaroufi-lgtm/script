end

local function UpdateThemeColor(newColor)
	Theme.Accent = newColor
	State.Accent = newColor
	for _, stroke in ipairs(AccentStrokes) do
		if stroke and stroke.Parent then stroke.Color = newColor end
	end
	for _, txt in ipairs(AccentTexts) do
		if txt and txt.Parent then txt.TextColor3 = newColor end
	end
	for _, bg in ipairs(AccentBackgrounds) do
		if bg and bg.Parent then bg.BackgroundColor3 = newColor end
	end
end

