local function MakeCard(parent, height)
	local card = Instance.new("Frame")
	card.BackgroundColor3 = Theme.Card
	card.BorderSizePixel = 0
	card.Size = UDim2.new(1, -12, 0, height)
	card.Parent = parent
	Corner(card, 10)
	Stroke(card, Color3.fromRGB(35, 35, 48), 0, 1)
