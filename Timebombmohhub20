    task.spawn(function()
        local path = PathfindingService:CreatePath({
            AgentRadius = 2,
            AgentHeight = 5,
            AgentCanJump = true,
            WaypointSpacing = 4,
            Costs = { Water = 20 }
        })

        local currentWaypoints = {}
        local nextWaypointIndex = 1
        local lastPathTick = 0

        RunService.RenderStepped:Connect(function()
            if not AutoFollowEnabled then return end
            local char = LocalPlayer.Character
            if not char then return end

            local humanoid = char:FindFirstChildOfClass("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not humanoid or not hrp then return end

            if humanoid.MoveDirection.Magnitude > 0.1 then
                return
            end

            local holdingTool = char:FindFirstChildOfClass("Tool")
            if not holdingTool then return end

            local targetPlr, shortestDist = nil, math.huge
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    local targetHrp = p.Character.HumanoidRootPart
                    local dist = (hrp.Position - targetHrp.Position).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        targetPlr = p
                    end
                end
            end

            if targetPlr and targetPlr.Character and targetPlr.Character:FindFirstChild("HumanoidRootPart") then
                local targetHrp = targetPlr.Character.HumanoidRootPart
                local predictedPos = targetHrp.Position + (targetHrp.AssemblyLinearVelocity * 0.3)

                local now = tick()
                if now - lastPathTick > 0.3 then
                    lastPathTick = now
                    pcall(function()
                        path:ComputeAsync(hrp.Position, predictedPos)
                        currentWaypoints = path:GetWaypoints()
                        nextWaypointIndex = 2
                    end)
                end

                if currentWaypoints and #currentWaypoints >= nextWaypointIndex then
                    local waypoint = currentWaypoints[nextWaypointIndex]
                    if waypoint then
                        humanoid:MoveTo(waypoint.Position)
                        if waypoint.Action == Enum.PathWaypointAction.Jump then
                            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                        end
                        if (hrp.Position - waypoint.Position).Magnitude < 3.5 then
                            nextWaypointIndex = nextWaypointIndex + 1
                        end
                    end
                else
                    humanoid:MoveTo(predictedPos)
                end
            end
        end)
    end)

