  <!-- Replace the href text and label as needed -->
  <a class="green-button" href="https://ssdmd190-code.github.io/ZQ-HUB-/" aria-label="Open ZQ-HUB">Open ZQ‑HUB</a>
</body>
</html>:root{
  --bg-0: #fff5f5;
  --bg-1: #ffecec;
  --accent: #ff3b3b;        /* button / primary red */
  --accent-strong: #e03131; /* hover */
  --text: #1b1b1b;
  --muted: #6b6b6b;
  --radius: 12px;
  --btn-padding: 14px 32px;
  --btn-font-size: 18px;
  --btn-shadow: 0 2px 10px rgba(255, 59, 59, 0.18);
  --container-max: 980px;
  --pad: 20px;
}

*{box-sizing:border-box}
html,body{height:100%}
body{
  margin:0;
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
  color:var(--text);
  background: linear-gradient(180deg, var(--bg-1), #ffffff);
  -webkit-font-smoothing:antialiased;
  -moz-osx-font-smoothing:grayscale;
  line-height:1.45;
}

.container{
  max-width: var(--container-max);
  margin: 0 auto;
  padding: 24px;
}

/* Header */
.site-header{
  background: linear-gradient(90deg, var(--accent), var(--accent-strong));
  color: white;
  padding: 18px 0;
  box-shadow: 0 6px 20px rgba(224,49,49,0.08);
}
.site-header .container{ display:flex; align-items:center; justify-content:space-between; gap:16px; }
.site-title{ margin:0; font-size:20px; letter-spacing:0.6px; font-weight:700; }
.owner{ font-size:14px; opacity:0.95 }

/* Main */
.main-content{ text-align:center; padding:72px 24px; }
.lead{ color:var(--muted); font-size:16px; margin-bottom:28px }

/* Red button (link) */
.red-button{
  display:inline-block;
  padding: var(--btn-padding);
  background: var(--accent);
  color: #fff;
  font-weight:700;
  font-size: var(--btn-font-size);
  text-transform:uppercase;
  letter-spacing:0.6px;
  border-radius: var(--radius);
  text-decoration:none;
  box-shadow: var(--btn-shadow);
  transition: background 160ms ease, box-shadow 160ms ease, transform 120ms ease;
  -webkit-tap-highlight-color: transparent;
}

.red-button:hover,
.red-button:focus{
  background: var(--accent-strong);
  box-shadow: 0 8px 30px rgba(224,49,49,0.18);
  transform: translateY(-2px);
  outline:none;
}

.red-button:active{ transform: translateY(0); box-shadow: var(--btn-shadow); }

.red-button:focus-visible{
  box-shadow: 0 0 0 4px rgba(224,49,49,0.14);
}

/* Footer */
.site-footer{
  border-top: 1px solid rgba(0,0,0,0.04);
  padding: 18px 0;
  text-align:center;
  color:var(--muted);
  font-size:13px;
}

/* Accessibility: reduced motion */
@media (prefers-reduced-motion: reduce){
  .red-button { transition: none; transform: none; }
  .site-header, .main-content { transition: none; }
}

/* Responsive tweaks */
@media (max-width:640px){
  .site-header .container{ flex-direction:column; align-items:flex-start }
  .main-content{ padding:40px 18px }
  .red-button{ width:100%; text-align:center; padding:14px 18px }
}
